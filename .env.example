# cTrader Open API Credentials
# cTrader Open API Portal (https://openapi.ctrader.com) の Playground から取得した値を設定してください。
CTRADER_CLIENT_ID="your_client_id_here"
CTRADER_CLIENT_SECRET="your_client_secret_here"
CTRADER_ACCOUNT_ID="your_account_id_here"
CTRADER_ACCESS_TOKEN="your_access_token_here"

# 長期常駐運用時の自動トークン更新用（任意・推奨）
# 管理画面の「cTraderを連携」で認可すると、トークンは SQLite (data/ntrade.db の oauth_tokens) に保存され、
# 期限の3日前に自動更新される。SQLite に保存済みのトークンは下の .env の値より優先される。
CTRADER_REFRESH_TOKEN="your_refresh_token_here"

# 接続先環境: "DEMO" または "LIVE" (デフォルトは DEMO)
CTRADER_ENV="DEMO"

# --- FIX API（発注経路の切り替え・任意） ---
# ブローカーが Open API 経由の取引を無効化している場合（新規注文に TRADING_DISABLED が返る）、
# ここを設定すると発注だけを FIX API 経由で行う。
# データ取得・口座情報・ポジション照合は Open API のまま（FIX は履歴も残高も取得できないため）。
#
# 認証情報は cTrader のデスクトップ/Web 版の「設定 → FIX API」から取得する。
# CTRADER_FIX_HOST を設定しない限り FIX は使われず、発注は Open API のまま。
# CTRADER_FIX_HOST="h50.p.ctrader.com"
# 取引セッションのポート（SSL: 5212 / 平文: 5202）
# CTRADER_FIX_PORT="5212"
# CTRADER_FIX_TLS="true"
# "<環境>.<BrokerUID>.<ログイン番号>" 形式
# CTRADER_FIX_SENDER_COMP_ID="demo.axiory.8069118"
# 数値のログイン番号
# CTRADER_FIX_USERNAME="8069118"
# CTRADER_FIX_PASSWORD="your_fix_password"
# Heartbeat 間隔（秒・既定 30）
# CTRADER_FIX_HEARTBEAT="30"

# --- エンジン動作設定 ---
# 5分足確定ごとの常駐スケジューラを止める場合は off
# NTRADE_SCHEDULER="off"
# 対象ペア（カンマ区切り、既定 USDJPY）
# NTRADE_PAIRS="USDJPY,EURUSD"
# 足確定からデータ取得までの待ち秒数（既定 15）
# NTRADE_BAR_DELAY_SECS="15"
# 実発注（cTrader経由）
NTRADE_LIVE_ORDERS="1"
