# cTrader Open API Credentials
# cTrader Open API Portal (https://openapi.ctrader.com) の Playground から取得した値を設定してください。
CTRADER_CLIENT_ID="your_client_id_here"
CTRADER_CLIENT_SECRET="your_client_secret_here"
CTRADER_ACCOUNT_ID="your_account_id_here"
CTRADER_ACCESS_TOKEN="your_access_token_here"

# 長期常駐運用時の自動トークン更新用（任意・推奨）
CTRADER_REFRESH_TOKEN="your_refresh_token_here"

# 接続先環境: "DEMO" または "LIVE" (デフォルトは DEMO)
CTRADER_ENV="DEMO"

# --- エンジン動作設定 ---
# 5分足確定ごとの常駐スケジューラを止める場合は off
# NTRADE_SCHEDULER="off"
# 対象ペア（カンマ区切り、既定 USDJPY）
# NTRADE_PAIRS="USDJPY,EURUSD"
# 足確定からデータ取得までの待ち秒数（既定 15）
# NTRADE_BAR_DELAY_SECS="15"
# 実発注を有効化（既定はペーパー）。デモ口座で十分に検証してから 1 にすること
# NTRADE_LIVE_ORDERS="1"
